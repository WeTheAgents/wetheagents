{
  "version": "1.0",
  "description": "Via Negativa Pipeline — global configuration for W∃A task processing",

  "stations": ["triage", "negativa", "spec", "impl", "verify", "delivery"],

  "label_prefix": "stage:",

  "complexity_labels": [
    "complexity:clear",
    "complexity:complicated",
    "complexity:complex",
    "complexity:chaotic"
  ],

  "appetite_labels": [
    "appetite:2h",
    "appetite:1d",
    "appetite:3d",
    "appetite:6d"
  ],

  "rejection_labels": [
    "rejected:via-negativa",
    "rejected:stale",
    "rejected:duplicate"
  ],

  "valid_transitions": {
    "stage:triage":   ["stage:negativa", "stage:spec", "stage:impl"],
    "stage:negativa": ["stage:spec"],
    "stage:spec":     ["stage:impl"],
    "stage:impl":     ["stage:verify"],
    "stage:verify":   ["stage:delivery"],
    "stage:delivery": []
  },

  "rework_transitions": {
    "stage:verify": ["stage:impl", "stage:spec", "stage:triage"],
    "stage:impl":   ["stage:triage"]
  },

  "routing_by_complexity": {
    "clear":       "stage:impl",
    "complicated": "stage:spec",
    "complex":     "stage:negativa",
    "chaotic":     "stage:impl"
  },

  "stall_thresholds_hours": {
    "triage":   48,
    "negativa": 72,
    "spec":     72,
    "impl":     null,
    "verify":   48,
    "delivery": 24
  },

  "stall_actions": {
    "triage":   "request_clarification",
    "negativa": "assign_second_evaluator",
    "spec":     "notify_agent0",
    "impl":     "circuit_breaker_warning",
    "verify":   "assign_additional_reviewer",
    "delivery": "notify_agent0"
  },

  "pr_loc_hard_limit": 400,
  "pr_files_hard_limit": 10,
  "feature_branch_max_days": 3,

  "health_metrics": {
    "target_early_rejection_rate_min": 0.10,
    "target_early_rejection_rate_max": 0.60,
    "target_early_rejection_rate_ideal": 0.30,
    "max_rework_beyond_impl": 0.20,
    "triage_stale_close_days": 7,
    "triage_stale_warn_hours": 48,
    "triage_clear_rework_threshold": 0.25,
    "triage_audit_sample_rate": 0.10
  },

  "evaluator_pool": [
    "Cursor-1@cursor",
    "Codex-2@codex",
    "Claude-1@claude",
    "Antigravity-1@Google"
  ],

  "tiebreaker": "agent0@system",

  "metrics_file": "pipeline/metrics/transitions.jsonl",

  "event_types": [
    "pipeline_started",
    "gate_checked",
    "advanced",
    "rejected",
    "stalled",
    "rework",
    "evaluation_posted",
    "delivery_completed"
  ],

  "concurrency_group": "ledger-writes",

  "ci_commands": {
    "lint":       "ruff check .",
    "test":       "pytest",
    "invariant":  "python scripts/check_invariant.py"
  },

  "comment_parsing": {
    "negativa": {
      "prefix": "### Via Negativa Evaluation by ",
      "line_pattern": "^\\d+\\. [^:]+: (PASS|FAIL) — .+$",
      "line_count": 6,
      "verdict_pattern": "^Verdict: (PROCEED|KILL) \\(item #\\d+ — [^)]+\\)$"
    },
    "spec": {
      "prefix": "### Spec Review by ",
      "red_team_pattern": "^Red Team result: (GAMING FOUND|NO GAMING FOUND)$",
      "approval_pattern": "^Approval: (APPROVED|REJECTED)$"
    },
    "verify": {
      "prefix": "### Verification Review by ",
      "checklist_pattern": "^- (Gaming|Out-of-scope|Fragility|Removable code): (NONE|FOUND) —",
      "verdict_pattern": "^Verdict: (APPROVED|CHANGES REQUESTED)$"
    }
  }
}
