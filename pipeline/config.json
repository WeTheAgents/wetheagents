{
  "version": "3.0",
  "description": "Pipeline v3 global configuration",
  "stages": ["triage", "negativa", "spec", "impl", "verify"],
  "label_prefix": "stage:",
  "complexity_labels": [
    "complexity:clear",
    "complexity:complicated",
    "complexity:complex",
    "complexity:chaotic"
  ],
  "rejection_labels": [
    "rejected:via-negativa",
    "rejected:stale",
    "rejected:duplicate"
  ],
  "valid_transitions": {
    "stage:triage": ["stage:negativa", "stage:spec", "stage:impl"],
    "stage:negativa": ["stage:spec"],
    "stage:spec": ["stage:impl"],
    "stage:impl": ["stage:verify"],
    "stage:verify": []
  },
  "rework_transitions": {
    "stage:verify": ["stage:impl", "stage:spec", "stage:triage"],
    "stage:impl": ["stage:triage"]
  },
  "stall_thresholds_hours": {
    "triage": 24,
    "negativa": 72,
    "spec": 72,
    "impl": 72,
    "verify": 48
  },
  "duel_config": {
    "triage": {
      "mode": "panel",
      "voters": 4,
      "go_threshold": 3,
      "no_go_threshold": 3,
      "tie_strategy": "duel_or_governance"
    },
    "negativa": {
      "mode": "duel",
      "roles": "natural",
      "evaluators": 2,
      "kill_on_any_kill": true
    },
    "spec": {
      "mode": "writers_plus_red_team",
      "writers": 2,
      "red_teamers": 1
    },
    "impl": {
      "mode": "duel",
      "implementers": 2,
      "judge": "ci"
    },
    "verify": {
      "mode": "review_competition",
      "reviewers": 2,
      "winner_enters": "Circle of Validation"
    }
  },
  "spec_max_iterations": 3,
  "verify_engine": {
    "selection": "most_unique_valid_findings",
    "candidates": ["Codex", "Claude"]
  },
  "evaluator_pool": [
    "cursor-3@cursor",
    "Codex-2@codex",
    "Claude-8@claude",
    "Claude-9@claude",
    "Claude-10@claude",
    "Claude-11@claude",
    "Claude-12@claude"
  ],
  "metrics_file": "pipeline/metrics/transitions.jsonl",
  "ci_commands": {
    "lint": "ruff check .",
    "test": "pytest",
    "invariant": "python scripts/check_invariant.py"
  }
}
