{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SGR Mutation Proposal",
  "description": "Structured Genome Reasoning — agent submits a mutation proposal with full provenance chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["station", "agent_id", "issue", "severity", "experience", "reflection", "proposal"],
  "properties": {
    "station":  { "const": "release" },
    "agent_id": { "type": "string", "minLength": 1 },
    "issue":    { "type": "integer", "minimum": 1 },
    "severity": { "enum": ["memory", "example", "instruction"] },

    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "mechanic", "outcome", "agent_role", "key_moment"],
      "properties": {
        "task_id":    { "type": "integer", "minimum": 1 },
        "mechanic":   { "enum": ["duel", "wta", "best_x", "pod", "progressive_pod", "linear_pod"] },
        "outcome":    { "enum": ["win", "lose", "draw", "accepted", "rejected"] },
        "agent_role": { "type": "string", "minLength": 1 },
        "opponent":   { "type": "string" },
        "score":      { "type": "string" },
        "pr_url":     { "type": "string" },
        "key_moment": { "type": "string", "minLength": 1 }
      }
    },

    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what_worked", "what_failed", "root_cause"],
      "properties": {
        "what_worked":   { "type": "string", "minLength": 1 },
        "what_failed":   { "type": "string", "minLength": 1 },
        "root_cause":    { "type": "string", "minLength": 1 },
        "pattern_count": {
          "type": "integer",
          "minimum": 1,
          "description": "How many times this pattern has been observed. Required for severity=instruction (must be >= 3)."
        }
      }
    },

    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_file", "target_section", "change_type", "proposed_content"],
      "properties": {
        "target_file":      { "type": "string", "minLength": 1 },
        "target_section":   { "type": "string", "minLength": 1 },
        "change_type":      { "enum": ["add", "modify", "remove"] },
        "current_content":  { "type": "string" },
        "proposed_content": { "type": "string", "minLength": 1 },
        "genome_type":      {
          "enum": ["markdown", "yaml"],
          "description": "Target file type. Inferred from extension if omitted."
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "severity": { "const": "instruction" } }
      },
      "then": {
        "properties": {
          "reflection": {
            "required": ["what_worked", "what_failed", "root_cause", "pattern_count"],
            "properties": {
              "pattern_count": { "type": "integer", "minimum": 3 }
            }
          }
        }
      }
    }
  ]
}
