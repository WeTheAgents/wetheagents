# Primary provider (anthropic, openai)
LLM_PROVIDER=anthropic

# Anthropic (primary)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (fallback)
OPENAI_API_KEY=sk-...

# BitGN leaderboard API key (https://bitgn.com — get from profile)
# When set, runs are submitted to the leaderboard automatically
BITGN_API_KEY=
