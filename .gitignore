# Local-only directories (historical artifacts, not part of distribution)
devlogs/
research/

# Vendored btc_dashboard — runtime state only, never committed.
/vendor/btc_dashboard/node_modules/
/vendor/btc_dashboard/data/

# Raw (uncensored) diaries — stored in wetheagents-private, never in public repo
agent0_diary_raw/

# Local overrides (never distributed, root only)
/CLAUDE.local.md
/AGENTS.local.md

# Agent worktree secrets
/.env
/.env.*
!/.env.example

# Telegram inbox: raw queue + offset state are local; decisions are committed
agent0/inbox/telegram_queue.jsonl
agent0/inbox/telegram_state.json

# Claude Code agent worktrees
.claude/worktrees/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Generated runtime locks (scheduled-tasks MCP etc.) — machine-local state
.claude/*.lock

# Scratch / temp artifacts
test_write_tmp.txt
.tmp_*

# Run event store (local observability data)
.wea_runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Claude Code local extensions (machine-specific)
.claude/agents/
.claude/skills/

# MCP local config (machine-specific server connections)
.mcp.json

# Codex temp artifacts
.codex_tmp/

# fast-agent runtime environments (sessions, caches, forks)
domains/fast-agent/
domains/fast-agent-agent0/
domains/fast-agent-pr733/

# Agent0 session diaries (curated versions go to agent0_diary_raw/)
agent0_diary/

# claude-doctor audit artifacts (external tool diagnostics)
claude_doctor/

# Domain-level caches and temp data
.llm_cache/
catboost_info/

# Poker arena session logs (runtime artifacts, 2M+ lines)
domains/poker/data/arena_sessions/

# Poker browser profiles (Chromium runtime data)
domains/poker/profiles/

# Debug/temp knowledge artifacts
domains/**/knowledge/debug_*.txt

# Domain-level env files and local Claude settings
domains/**/.env
domains/**/.claude/

# Parquet temp files
*.parquet

# Domain picks (large JSON checkpoint/result files)
domains/**/picks/

# Over pilot data (large JSON)
domains/**/knowledge/over_pilot/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Strix runtime event logs
strix_runs/

# Serena IDE config
.serena/

# BitGN traces (runtime evolution data, regenerable)
domains/bitgn/traces/

# Pipeline temp provenance
pipeline/release/.provenance_tmp.json

# Local workplace role selector; never publish an agent-specific root override
/AGENTS.override.md
